<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #000000;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="org.example.demo13.ChatController">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to bottom, #1a1a1a, #000000); -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,150,255,0.3), 10, 0, 0, 5);">
            <Label style="                 -fx-text-fill: linear-gradient(to right, #00d2ff, #3a7bd5);                 -fx-font-size: 22px;                 -fx-font-weight: bold;                 -fx-font-family: 'Segoe UI';                 -fx-effect: dropshadow(one-pass-box, rgba(0,210,255,0.5), 0, 0, 0, 1);             " text="⚡ Mamad Chat Pro" />
        </HBox>
    </top>


    <center>
        <TextArea fx:id="chatArea" editable="false" style="             -fx-font-size: 15px;             -fx-text-fill: #e0e0e0;             -fx-control-inner-background: #121212;             -fx-highlight-fill: #00d2ff;             -fx-highlight-text-fill: #000000;             -fx-padding: 20;             -fx-border-color: #252525;             -fx-border-width: 1;         " wrapText="true" />
    </center>


    <bottom>
        <VBox style="-fx-background-color: #0a0a0a; -fx-padding: 15; -fx-border-color: #252525; -fx-border-width: 1 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <TextField fx:id="inputField" promptText="پیام خود را وارد کنید..." style="                     -fx-font-size: 14px;                     -fx-text-fill: #ffffff;                     -fx-prompt-text-fill: #555555;                     -fx-background-color: #1a1a1a;                     -fx-border-color: #333333;                     -fx-border-radius: 5;                     -fx-padding: 12;                 " HBox.hgrow="ALWAYS" />
                <Button onAction="#onSend" style="                     -fx-font-size: 14px;                     -fx-text-fill: #ffffff;                     -fx-background-color: linear-gradient(to right, #00d2ff, #3a7bd5);                     -fx-background-radius: 5;                     -fx-padding: 12 25;                     -fx-cursor: hand;                     -fx-effect: dropshadow(three-pass-box, rgba(0,210,255,0.3), 5, 0, 0, 2);                 " text="ارسال" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
